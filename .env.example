# ===========================================================================
# Telegram Commerce Platform — environment configuration
#
# Copy to .env and fill in. NEVER commit a real .env.
# Generate the secrets below with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# ===========================================================================

# --- Core ------------------------------------------------------------------
ENVIRONMENT=local            # local | staging | production
DEBUG=false                  # must be false in production
APP_NAME=Telegram Commerce
SERVICE=all                  # bot | api | worker | all

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Leave the webhook base URL empty to use long polling (simplest for a start).
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Random string; Telegram echoes it so the bot can reject forged webhook calls.
TELEGRAM_WEBHOOK_SECRET=
# Telegram user ids granted SUPER_ADMIN on first /admin. Comma-separated.
TELEGRAM_BOOTSTRAP_ADMIN_IDS=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_GLOBAL_RATE_LIMIT=25
TELEGRAM_CHAT_RATE_LIMIT=1.0

# --- Database (Supabase / PostgreSQL) --------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the *session* pooler for migrations and the transaction pooler for the app.
# Replace the postgres:// scheme with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false
# Supabase's transaction-mode pooler (pgbouncer) rejects prepared statements.
# Keep this at 0 when connecting through it.
DATABASE_STATEMENT_CACHE_SIZE=0

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=tgshop
REDIS_MAX_CONNECTIONS=50

# --- Security --------------------------------------------------------------
# Fernet key encrypting provider credentials, stock payloads and delivered
# goods at rest. Losing it makes every stored secret unreadable — back it up.
SECURITY_SECRETS_ENCRYPTION_KEY=
# Old keys kept for decryption during a key rotation. Comma-separated.
SECURITY_SECRETS_PREVIOUS_KEYS=
# Pepper mixed into API key hashing. Changing it invalidates every issued key.
SECURITY_API_KEY_PEPPER=
SECURITY_ADMIN_CONFIRMATION_TTL=300

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ROOT_PATH=
API_DOCS_ENABLED=true
API_CORS_ORIGINS=
API_DEFAULT_RATE_LIMIT_PER_MINUTE=120
API_IDEMPOTENCY_TTL_SECONDS=86400

# --- Payment policy --------------------------------------------------------
PAYMENT_DEFAULT_WINDOW_SECONDS=1800
# Shortfall accepted as full payment. Keep at 0 unless you deliberately want
# to absorb a fee; underpayment is otherwise never auto-credited.
PAYMENT_UNDERPAYMENT_TOLERANCE=0
# Overshoot accepted without review.
PAYMENT_OVERPAYMENT_TOLERANCE=0
# How long after expiry a late transaction is still reconciled.
PAYMENT_LATE_PAYMENT_GRACE_SECONDS=86400
PAYMENT_VERIFICATION_POLL_INTERVAL=20
PAYMENT_MAX_VERIFICATION_ATTEMPTS=120
PAYMENT_RESERVATION_TTL_SECONDS=2400
PAYMENT_DELIVERY_MAX_ATTEMPTS=8
PAYMENT_ORDER_REFERENCE_PREFIX=TG

# --- Feature flags ---------------------------------------------------------
FEATURE_COUPONS_ENABLED=true
FEATURE_REFERRALS_ENABLED=true
FEATURE_RESELLER_ENABLED=true
# false puts new reseller applications into PENDING for admin approval.
FEATURE_RESELLER_SELF_ACTIVATION=true
FEATURE_SUPPORT_ENABLED=true
FEATURE_BROADCAST_ENABLED=true
FEATURE_RESTOCK_NOTIFICATIONS_ENABLED=true
FEATURE_REVIEWS_ENABLED=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
LOG_INCLUDE_CORRELATION=true

# ===========================================================================
# Payment provider credentials
#
# These are NOT read from the environment. Configure them in the Telegram
# admin panel (Providers -> Configure credentials), where they are encrypted
# with SECURITY_SECRETS_ENCRYPTION_KEY before being stored.
#
# Always use READ-ONLY API keys. Withdrawal permission is never required by
# this platform and must not be granted.
#
#   Binance  : Wallet deposit history  (Enable Reading)
#   Bybit    : Assets read             (read-only key)
#   OKX      : Funding read            (read-only key + passphrase)
#
# Blockchain RPC/indexer endpoints are configured per provider in the same
# screen. Defaults are seeded by scripts.seed and can be overridden there.
# ===========================================================================

# --- Testing ---------------------------------------------------------------
# Set to run the PostgreSQL concurrency tests; they are skipped without it.
TEST_DATABASE_URL=
